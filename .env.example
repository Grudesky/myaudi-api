# myaudi-api — environment template
# Copy to .env (gitignored) and fill in your values.

# --- Audi Connect credentials (required) ---
AUDI_USERNAME=your.email@example.com
AUDI_PASSWORD=your_password
AUDI_COUNTRY=DE
AUDI_API_LEVEL=1

# S-PIN required for lock/unlock, remote engine start, and other security-pin
# actions (optional, but those actions are disabled without it).
AUDI_SPIN=1234

# Default VIN — skip --vin on the CLI when you only have one car.
# AUDI_DEFAULT_VIN=WAUXXXXXXXXXXXXX

# Explicit comma-separated VIN allowlist for remote engine start/stop.
# Matching is case-insensitive and ignores surrounding whitespace. Engine
# control is disabled for every VIN when this is unset or empty.
# AUDI_ENGINE_CONTROL_VINS=WA16AAGU2T2033252

# --- REST API authentication (required for the FastAPI server) ---
# All endpoints except /health, /ready and /metrics require this
# header: X-API-Key: <value>. Generate a strong key with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
AUDI_API_KEY=change_me_to_a_long_random_string

# Durable state is required to preserve the at-most-once engine-action guard
# across restarts. Use a path on a persistent volume in production.
# AUDI_ENGINE_ACTION_STATE_FILE=/data/engine-actions.json

# --- Webhooks (optional) ---
# If AUDI_WEBHOOK_URL is set, vehicle state changes are POSTed there.
# AUDI_WEBHOOK_URL=https://n8n.example.com/webhook/audi

# If AUDI_WEBHOOK_SECRET is set, outgoing webhooks are signed with
# HMAC-SHA256 in the X-Audi-Signature header.
# AUDI_WEBHOOK_SECRET=change_me_to_a_long_random_string

# --- Background watcher (API server only) ---
# 0 = disabled. Otherwise, minimum 900 (15 min) — Audi rate-limits
# to ~6 req/h, going lower will lock your account.
AUDI_WATCH_INTERVAL=0

# Minimum interval between normal live /status requests. Force requests bypass
# this application cooldown, but remain subject to Audi's upstream rate limit.
AUDI_LIVE_POLL_MIN_INTERVAL=900

# Durable last-known position and odometer-trigger state. Use a path on a
# persistent volume so restarts neither lose position nor repeat a deferred GET.
# AUDI_POSITION_STATE_FILE=/data/position-state.json
# Golem: /Users/admin/myAudi/config/.env should instead contain:
# AUDI_POSITION_STATE_FILE=/Users/admin/myAudi/state/position-state.json

# --- Goodnight check (API server only, requires watcher) ---
# Local hour (1-23) at which to check if the vehicle is locked and plugged.
# 0 = disabled. Webhook fires only when at least one alert is raised
# (no notification on "all good"). Fires once per day at the configured hour.
# AUDI_GOODNIGHT_HOUR=22

# --- Cache (API server only) ---
# Vehicle data cache TTL in seconds. Default 4h. Don't lower below
# 1h without understanding the rate limit implications.
AUDI_CACHE_TTL=14400

# --- Timezone (optional, defaults to Europe/Paris) ---
# TZ=Europe/Brussels
